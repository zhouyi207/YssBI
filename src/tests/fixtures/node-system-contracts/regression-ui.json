          "collapsible": false
        }
      },
      "visible": true,
      "children": ["modelSummary-content"]
    },
    "modelSummary-content": {
      "component": {
        "type": "keyValue",
        "props": {
          "binding": "summary"
        }
      },
      "visible": true,
      "children": []
    },
    "anova": {
      "component": {
        "type": "section",
        "props": {
