          "binding": "serialTests"
        }
      },
      "visible": true,
      "children": []
    },
    "report": {
      "component": {
        "type": "column",
        "props": {
          "gap": 4
        }
      },
      "visible": true,
      "children": [
        "equation",
        "modelSummary",
        "anova",
        "coefficientTable",
        "coefficientMagnitude",
        "hypothesisTest",
        "diagnostics",
        "residualPlot",
        "observations",
