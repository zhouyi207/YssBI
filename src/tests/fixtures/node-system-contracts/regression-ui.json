{
  "root": "report",
  "elements": {
    "equation": {
      "component": {
        "type": "section",
        "props": {
          "title": "Equation",
          "collapsible": false
        }
      },
      "visible": true,
      "children": ["equation-content"]
    },
    "equation-content": {
      "component": {
        "type": "equation",
        "props": {
          "binding": "equation"
        }
      },
      "visible": true,
      "children": []
    },
    "modelSummary": {
      "component": {
        "type": "section",
