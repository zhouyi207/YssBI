{
  "name": "exponential decay normal",
  "data": {
    "columns": [
      {
        "name": "x",
        "values": [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5]
      },
      {
        "name": "y",
        "values": [5.1, 4.25, 3.55, 2.95, 2.55, 2.2, 1.95, 1.8]
      }
    ]
  },
  "modelSpec": {
    "dataset": {
      "sourceType": "table",
      "sourceId": "fixture-exponential-decay-normal"
    },
    "response": {
      "expression": {
        "type": "data_variable",
        "name": "y"
      },
      "dataVariables": {
        "y": "y"
      }
    },
    "predictor": {
      "type": "binary",
      "op": "add",
      "left": {
        "type": "binary",
        "op": "mul",
        "left": {
          "type": "parameter",
          "name": "a"
        },
        "right": {
          "type": "call",
          "function": "exp",
          "args": [
            {
              "type": "unary",
              "op": "neg",
              "arg": {
                "type": "binary",
                "op": "mul",
                "left": {
                  "type": "parameter",
                  "name": "b"
                },
                "right": {
                  "type": "data_variable",
                  "name": "x"
                }
              }
            }
          ]
        }
      },
      "right": {
        "type": "parameter",
        "name": "c"
      }
    },
    "dataVariables": {
      "x": "x"
    },
    "likelihood": {
      "type": "normal",
      "mean": {
        "source": "predictor"
      },
      "sigma": {
        "parameter": "sigma"
      }
    },
    "parameters": [
      {
        "name": "a",
        "constraint": {
          "type": "real"
        },
        "prior": {
          "distribution": "normal",
          "args": [3.0, 2.0]
        }
      },
      {
        "name": "b",
        "constraint": {
          "type": "positive"
        },
        "prior": {
          "distribution": "exponential",
          "args": [1.0]
        }
      },
      {
        "name": "c",
        "constraint": {
          "type": "real"
        },
        "prior": {
          "distribution": "normal",
          "args": [1.0, 2.0]
        }
      },
      {
        "name": "sigma",
        "constraint": {
          "type": "positive"
        },
        "prior": {
          "distribution": "exponential",
          "args": [1.0]
        }
      }
    ],
    "sampler": {
      "algorithm": "nuts",
      "chains": 2,
      "samples": 40,
      "warmup": 20,
      "seed": 4321,
      "targetAccept": 0.8,
      "maxTreeDepth": 10,
      "saveSamples": true
    },
    "displayFormula": "y ~ Normal(a * exp(-b * x) + c, sigma)"
  },
  "golden": {
    "parameters": ["a", "b", "c", "sigma"],
    "posteriorMean": {
      "a": {
        "expected": 4.0,
        "tolerance": 2.5
      },
      "b": {
        "expected": 0.6,
        "tolerance": 1.0
      },
      "c": {
        "expected": 1.0,
        "tolerance": 2.0
      },
      "sigma": {
        "expected": 0.3,
        "tolerance": 2.0
      }
    },
    "maxRhat": 3.0,
    "requiresSamples": true,
    "requiresPosteriorPredictive": true
  }
}
