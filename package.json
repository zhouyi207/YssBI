{
    "name": "yssbi",
    "private": true,
    "version": "0.2.7",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
        "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
        "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml -p yssbi --jobs 1",
        "rust:test:lib": "cargo test --manifest-path src-tauri/Cargo.toml -p yssbi --lib --jobs 1",
        "rust:test:sci": "cargo test --manifest-path src-tauri/Cargo.toml -p yss-sci --jobs 1",
        "rust:bench:column-analytics": "cargo bench --manifest-path src-tauri/Cargo.toml -p yss-sci --bench column_analytics_wide",
        "rust:clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
        "verify:frontend": "pnpm typecheck && pnpm test",
        "verify:rust": "pnpm rust:fmt:check && pnpm rust:check",
        "verify:rust:full": "pnpm verify:rust && pnpm rust:test && pnpm rust:test:sci",
        "verify": "pnpm verify:frontend && pnpm verify:rust && git diff --check",
        "verify:full": "pnpm verify:frontend && pnpm verify:rust:full && git diff --check"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@tanstack/react-virtual": "^3.14.9",
        "@tauri-apps/api": "^2.11.0",
        "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@tauri-apps/plugin-opener": "^2",
        "ag-grid-community": "36.1.0",
        "ag-grid-react": "36.1.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "d3": "^7.9.0",
        "dockview-react": "^8.1.0",
        "i18next": "^26.0.8",
        "katex": "^0.18.4",
        "lodash": "^4.18.1",
        "marked": "^18.0.9",
        "pinyin-pro": "3.29.1",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.11",
        "react-icons": "^5.5.0",
        "react-markdown": "^10.1.0",
        "react-responsive-carousel": "^3.2.23",
        "react-router": "^8.3.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "shadcn": "^4.18.0",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.0",
        "@types/d3": "^7.4.3",
        "@types/katex": "^0.16.8",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "happy-dom": "^20.11.2",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    },
    "engines": {
        "node": ">=22.22.0"
    },
    "packageManager": "pnpm@11.20.0"
}
