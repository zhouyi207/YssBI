{
    "name": "yssbi",
    "private": true,
    "version": "0.3.0",
    "type": "module",
    "scripts": {
        "dev": "tauri dev",
        "build": "tauri build",
        "check": "pnpm check:ts && pnpm check:rs",
        "check:ts": "tsc --noEmit",
        "check:rs": "cargo check --manifest-path src-tauri/Cargo.toml --workspace",
        "lint": "pnpm lint:ts && pnpm lint:rs",
        "lint:ts": "oxlint .",
        "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
        "test": "pnpm test:ts && pnpm test:rs",
        "test:ts": "vitest run",
        "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
        "format": "pnpm format:ts && pnpm format:rs",
        "format:ts": "oxfmt",
        "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
        "format:check": "pnpm format:check:ts && pnpm format:check:rs",
        "format:check:ts": "oxfmt --check",
        "format:check:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
        "ci": "pnpm format:check && pnpm check && pnpm lint && pnpm test"
    },
    "dependencies": {
        "@assistant-ui/react": "^0.15.16",
        "@dnd-kit/core": "^6.3.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@tanstack/react-virtual": "^3.14.9",
        "@tauri-apps/api": "^2.11.0",
        "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@tauri-apps/plugin-opener": "^2",
        "ag-grid-community": "36.1.0",
        "ag-grid-react": "36.1.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "d3": "^7.9.0",
        "dockview-react": "^8.2.0",
        "i18next": "^26.0.8",
        "katex": "^0.18.4",
        "lodash": "^4.18.1",
        "marked": "^18.0.9",
        "pinyin-pro": "3.29.1",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.11",
        "react-icons": "^5.5.0",
        "react-markdown": "^10.1.0",
        "react-responsive-carousel": "^3.2.23",
        "react-router": "^8.3.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "shadcn": "^4.18.0",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.0",
        "@types/d3": "^7.4.3",
        "@types/katex": "^0.16.8",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "happy-dom": "^20.11.2",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    },
    "engines": {
        "node": ">=22.22.0"
    },
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
